{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/turkiye_map/schema/region.schema.json",
  "title": "Region",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "level",
    "parent_id",
    "name",
    "name_ascii",
    "slug",
    "aliases",
    "region_kind",
    "member_ids",
    "source_hdx_id",
    "centroid",
    "bbox"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TR-R-[A-Z0-9]{3}$"
    },
    "level": {
      "const": "region"
    },
    "parent_id": {
      "type": "null"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_ascii": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "region_kind": {
      "type": "string",
      "minLength": 1
    },
    "member_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TR-P-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "source_hdx_id": {
      "type": "string",
      "minLength": 1
    },
    "centroid": {
      "$ref": "#/$defs/point"
    },
    "bbox": {
      "$ref": "#/$defs/bbox"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    }
  }
}
